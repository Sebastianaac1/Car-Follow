# Variables de las dos apps. Vite solo expone al navegador las que empiezan con VITE_,
# y todo lo que expone es PÚBLICO: queda dentro del bundle que cualquiera puede leer.
# Por eso acá no hay ni puede haber ningún secreto — el token de sesión lo emite el
# backend en tiempo de ejecución, no se compila en ninguna parte.
#
# En local no hace falta copiar este archivo: los tres valores por defecto ya apuntan a
# los puertos de desarrollo. En Vercel se cargan en Settings > Environment Variables,
# una vez por proyecto (persona y taller son dos proyectos distintos).

# La API en Render. Sin barra final.
VITE_API_URL="http://localhost:3000"

# El dominio de la otra app, para el cruce entre las dos: si entrás con una cuenta que no
# corresponde a esta app, te manda allá. Sin barra final.
# En el proyecto `persona` de Vercel:
VITE_URL_TALLER="http://localhost:5174"
# En el proyecto `taller` de Vercel:
VITE_URL_PERSONA="http://localhost:5173"
